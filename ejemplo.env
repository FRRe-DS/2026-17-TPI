# Configuración de ejemplo de M2 Clientes, SOLO para desarrollo (RNF-06.3). docker compose la carga por defecto.
#
# Cada línea es VARIABLE=${VARIABLE:-valor}: si la variable está definida en el entorno de quien corre docker compose,
# manda ese valor; si no, el que está acá. Por ejemplo: M2_PUERTO=9090 docker compose up -d --build --wait
#
# Las claves y contraseñas de este archivo no sirven para nada fuera de una máquina de desarrollo.

# --- Servicio m2 ---

# Conexión a la base (obligatoria). Repite el usuario, la contraseña y la base de POSTGRES_* más abajo: se cambian juntos.
M2_URL_BD=${M2_URL_BD:-postgres://m2:m2-contrasena-de-desarrollo@bd:5432/m2}

# Puerto de escucha del servicio, también el que se publica en la máquina (por defecto, 8082).
M2_PUERTO=${M2_PUERTO:-8082}

# Clave con la que se firman y validan los tokens (obligatoria, al menos 32 caracteres).
M2_CLAVE_TOKENS=${M2_CLAVE_TOKENS:-clave-de-desarrollo-no-usar-en-produccion-0123456789}

# Emisor esperado de los tokens, el campo iss (obligatoria).
M2_EMISOR_TOKENS=${M2_EMISOR_TOKENS:-m1-identidad}

# Audiencia esperada de los tokens, el campo aud (obligatoria).
M2_AUDIENCIA_TOKENS=${M2_AUDIENCIA_TOKENS:-m2-clientes}

# Campo del token que trae los roles (por defecto, roles).
M2_CAMPO_ROLES=${M2_CAMPO_ROLES:-roles}

# Tiempo máximo de espera a la base, en milisegundos (por defecto, 2000).
M2_TIEMPO_BD_MS=${M2_TIEMPO_BD_MS:-2000}

# Tiempo máximo por intento a otro módulo, en milisegundos (por defecto, 2000).
M2_TIEMPO_MODULOS_MS=${M2_TIEMPO_MODULOS_MS:-2000}

# Reintentos de una lectura a otro módulo, de 0 a 5 (por defecto, 1).
M2_REINTENTOS_MODULOS=${M2_REINTENTOS_MODULOS:-1}

# Nombre del encabezado de correlación (por defecto, X-Request-Id).
M2_ENCABEZADO_CORRELACION=${M2_ENCABEZADO_CORRELACION:-X-Request-Id}

# URL base de M6 (Viajes), con su ruta /api/v1. Es obligatoria. El valor es del contrato del Grupo 12 en desarrollo: no hay un M6 en el compose.
M2_URL_M6=${M2_URL_M6:-http://m6:3006/api/v1}

# Audiencia (aud) del token de servicio con el que M2 se presenta ante M6 (por defecto, m6-viajes).
M2_AUDIENCIA_M6=${M2_AUDIENCIA_M6:-m6-viajes}

# Segundos que sugiere Retry-After cuando M6 no está disponible, de 1 a 3600 (por defecto, 5).
M2_REINTENTAR_DESPUES_S=${M2_REINTENTAR_DESPUES_S:-5}

# --- Servicio bd (PostgreSQL) ---

# Usuario que crea la imagen de PostgreSQL la primera vez que inicializa el volumen.
POSTGRES_USER=${POSTGRES_USER:-m2}

# Contraseña de ese usuario. Con el volumen ya creado, cambiarla no tiene efecto hasta borrarlo (docker compose down -v).
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-m2-contrasena-de-desarrollo}

# Base que se crea al inicializar.
POSTGRES_DB=${POSTGRES_DB:-m2}
