# Solo desarrollo local. No copiar estas variables al contenedor panel.
# docker compose -f docker-compose.yml -f docker-compose.front.yml --env-file ejemplo-front-keycloak.env up -d --build --wait
COMPOSE_PROFILES=front,keycloak
M2_MODO_TOKENS=jwks
M2_EMISOR_TOKENS=http://localhost:${KEYCLOAK_PUERTO:-8080}/realms/ds-2026-realm
PANEL_PUERTO=8083
