# Lo que cambia para levantar M2 en modo jwks contra el Keycloak del compose, SOLO para desarrollo (spec 080, RNF-06.7, RNF-06.8):
#   docker compose --env-file ejemplo-keycloak.env up -d --build --wait
#
# Compose lo carga como su propio entorno: activa el perfil keycloak y sus valores llegan a M2 por ejemplo.env, que sigue mandando en
# todo lo demás. Una variable definida en el entorno de quien corre docker compose manda sobre este archivo. Por ejemplo, otro puerto
# para Keycloak (cambia el publicado y el emisor a la vez): KEYCLOAK_PUERTO=18080 docker compose --env-file ejemplo-keycloak.env up -d --build --wait
# Para sumar también el panel: COMPOSE_PROFILES=keycloak,panel docker compose --env-file ejemplo-keycloak.env up -d --build --wait
# Para aplicar un cambio del realm (keycloak/) hace falta borrar el volumen: docker compose --env-file ejemplo-keycloak.env down -v
#
# Las contraseñas de Keycloak y su base tienen su valor de desarrollo en docker-compose.yml. El único secreto que trae este archivo
# es el de desarrollo del cliente grupo-17, el mismo que el realm de keycloak/ (spec 125, RNF-06).

# Perfiles de compose que se activan: Keycloak y su base.
COMPOSE_PROFILES=keycloak

# M2 valida los tokens con RS256 y las claves públicas de Keycloak (M2_URL_JWKS de ejemplo.env, por la red de compose).
M2_MODO_TOKENS=jwks

# Emisor de los tokens: el KC_HOSTNAME de docker-compose.yml más el realm. Usa el mismo KEYCLOAK_PUERTO; si no coinciden, todo token da 401.
M2_EMISOR_TOKENS=http://localhost:${KEYCLOAK_PUERTO:-8080}/realms/ds-2026-realm

# --- Token de servicio ante M6 (spec 125) ---
# M2 pide a Keycloak, por la red de compose y con el cliente grupo-17, el token con el que se presenta ante M6, en lugar de firmar el
# HS256. El M6 simulado de este perfil lo valida con el emisor que ve la máquina y las claves de Keycloak.

# Endpoint de tokens del realm, por la red de compose.
M2_URL_TOKENS_SERVICIO=http://keycloak:8080/realms/ds-2026-realm/protocol/openid-connect/token

# Cliente de Keycloak de M2 en el realm de la cátedra.
M2_CLIENTE_SERVICIO=grupo-17

# Secreto de desarrollo de grupo-17, el del realm de keycloak/. Solo para desarrollo: el de un Keycloak real va en el entorno.
M2_SECRETO_SERVICIO=d51a8e72-6c94-4f30-b217-9e5d3a608142

# Emisor que valida el M6 simulado: el mismo que M2_EMISOR_TOKENS.
M6_EMISOR_KEYCLOAK=http://localhost:${KEYCLOAK_PUERTO:-8080}/realms/ds-2026-realm

# Claves públicas con las que el M6 simulado valida el token, por la red de compose: las mismas de M2_URL_JWKS.
M6_URL_JWKS_KEYCLOAK=http://keycloak:8080/realms/ds-2026-realm/protocol/openid-connect/certs
