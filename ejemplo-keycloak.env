# Lo que cambia para levantar M2 en modo jwks contra el Keycloak del compose, SOLO para desarrollo (spec 080, RNF-06.7, RNF-06.8):
#   docker compose --env-file ejemplo-keycloak.env up -d --build --wait
#
# Compose lo carga como su propio entorno: activa el perfil keycloak y sus valores llegan a M2 por ejemplo.env, que sigue mandando en
# todo lo demás. Una variable definida en el entorno de quien corre docker compose manda sobre este archivo. Por ejemplo, otro puerto
# para Keycloak (cambia el publicado y el emisor a la vez): KEYCLOAK_PUERTO=18080 docker compose --env-file ejemplo-keycloak.env up -d --build --wait
# Para sumar también el panel: COMPOSE_PROFILES=keycloak,panel docker compose --env-file ejemplo-keycloak.env up -d --build --wait
# Para aplicar un cambio del realm (keycloak/) hace falta borrar el volumen: docker compose --env-file ejemplo-keycloak.env down -v
#
# No trae claves ni contraseñas: las de Keycloak y su base tienen su valor de desarrollo en docker-compose.yml.

# Perfiles de compose que se activan: Keycloak y su base.
COMPOSE_PROFILES=keycloak

# M2 valida los tokens con RS256 y las claves públicas de Keycloak (M2_URL_JWKS de ejemplo.env, por la red de compose).
M2_MODO_TOKENS=jwks

# Emisor de los tokens: el KC_HOSTNAME de docker-compose.yml más el realm. Usa el mismo KEYCLOAK_PUERTO; si no coinciden, todo token da 401.
M2_EMISOR_TOKENS=http://localhost:${KEYCLOAK_PUERTO:-8080}/realms/ds-2026-realm
