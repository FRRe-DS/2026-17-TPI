{
  "name": "m2-clientes",
  "version": "0.1.0",
  "description": "M2 Clientes · Grupo 17 · TPI Desarrollo de Software 2026",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.2.0"
  },
  "scripts": {
    "contrato:tipos": "openapi-typescript contrato/openapi.yml -o src/generado/contrato.ts",
    "contrato:test": "npm run build && node scripts/contrato-test.mjs",
    "prebuild": "npm run contrato:tipos",
    "build": "tsc -p tsconfig.build.json",
    "prelint": "npm run contrato:tipos",
    "lint": "eslint .",
    "pretest": "npm run contrato:tipos",
    "test": "vitest run --project unitarias --project integracion",
    "panel:tipos": "openapi-typescript contrato/openapi.yml -o panel/cliente/src/generado/contrato.ts",
    "panel:build": "npm run panel:tipos && tsc -p panel/tsconfig.servidor.json",
    "panel:navegador": "vitest run --project navegador"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
